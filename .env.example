# --- Firebase Admin SDK (server-side only, from your service account JSON) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Admin auth placeholder (delete if you wire in your existing auth) ---
JWT_SECRET=

# --- Frontend build-time API base (Vite). Omit for same-origin "/api" ---
VITE_API_BASE=/api
