# Server Configuration
PORT=5000
DATABASE_URL="file:./dev.db"

# Security
JWT_SECRET="corare_secret_jwt_key_super_secure_2026_minecraft_store"
SERVER_SECRET_KEY="corare_minecraft_secret_token_change_in_production"

# Payment (TrueMoney Wallet)
TRUEMONEY_MOBILE_PHONE="0812345678"

# Web Client
CORS_ORIGIN="http://localhost:5173"

# Minecraft Server RCON (corarevanilla.xyz SMP)
RCON_ENABLED="false"
RCON_HOST="corarevanilla.xyz"
RCON_PORT=25575
RCON_PASSWORD="your_rcon_password"

# Firebase Firestore Configuration
USE_FIREBASE="true"
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Or path to serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH="./serviceAccountKey.json"
